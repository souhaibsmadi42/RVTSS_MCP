 {
  "name": "qc model_checks naming rules",
  "path": "/qc/model_checks/",
  "body": {
   "checks": [
    "naming"
   ],
   "rules": {
    "naming": {
     "views": {
      "pattern": "^[A-Z]{2}-",
      "severity": "error"
     },
     "sheets": {
      "pattern": "^[A-Z]-\\d{3}$",
      "field": "number"
     },
     "levels": {
      "pattern": "^L\\d+$",
      "description": "levels use L1.."
     },
     "families": {
      "pattern": "^[A-Z]{3}_"
     },
     "types": {
      "pattern": "^\\d+"
     }
    }
   }
  },
  "ignore": [
   "timings_ms"
  ]
 },
 {
  "name": "qc model_checks naming bad pattern",
  "path": "/qc/model_checks/",
  "body": {
   "checks": [
    "naming"
   ],
   "rules": {
    "naming": {
     "views": {
      "pattern": "([unclosed"
     }
    }
   }
  },
  "ignore": [
   "timings_ms"
  ]
 },
