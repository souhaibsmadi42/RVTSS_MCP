 {
  "name": "qc model_checks iso19650 scheme",
  "path": "/qc/model_checks/",
  "body": {
   "checks": [
    "iso19650"
   ],
   "rules": {
    "iso19650": {
     "delimiter": "-",
     "fields": [
      {
       "name": "project",
       "values": [
        "P1"
       ]
      },
      {
       "name": "kind",
       "pattern": "^[A-Z]$"
      }
     ],
     "targets": {
      "sheets": {
       "source": "number"
      },
      "views": {},
      "view_templates": {},
      "families": {},
      "types": {},
      "worksets": {}
     }
    }
   }
  },
  "ignore": [
   "timings_ms"
  ]
 },
