 {
  "name": "qc model_checks required_parameters",
  "path": "/qc/model_checks/",
  "body": {
   "checks": [
    "required_parameters"
   ],
   "rules": {
    "required_parameters": [
     {
      "categories": [
       "Walls",
       "NoSuchCategory"
      ],
      "parameters": [
       "Mark",
       "Comments",
       "Fire Rating",
       "Nope"
      ],
      "severity": "warning"
     }
    ]
   }
  },
  "ignore": [
   "timings_ms"
  ]
 },
