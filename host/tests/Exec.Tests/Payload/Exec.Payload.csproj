<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stand-in for RvtssHost.Impl in the Exec.Tests harness: the real PyEngine.cs plus the checks.
       IronPython is a compile-time reference only: at run time it must come from the layout folder. -->
  <PropertyGroup>
    <AssemblyName>Exec.Payload</AssemblyName>
    <RootNamespace>RvtssHost.Tests</RootNamespace>
    <OutputPath>$(OutputPath)exec-tests\payload\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="IronPython" Version="3.4.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Mono.Unix" Version="7.1.0-final.1.21458.1" ExcludeAssets="all" PrivateAssets="all" />
    <Compile Include="..\..\..\RvtssHost.Impl\Modules\Exec\PyEngine.cs" Link="PyEngine.cs" />
  </ItemGroup>
</Project>
